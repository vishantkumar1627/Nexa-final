FROM python:3.12-slim

# Set environment paths
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

# Install Blender, OpenGL virtual buffers, and common building utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    blender \
    libglu1-mesa \
    libgl1 \
    libglx-mesa0 \
    libxi6 \
    libxrender1 \
    libxxf86vm1 \
    libxkbcommon0 \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Install requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy codebase
COPY . .

# Run Celery Worker
CMD ["celery", "-A", "workers.celery_app.celery_app", "worker", "--loglevel=info", "--concurrency=1"]
